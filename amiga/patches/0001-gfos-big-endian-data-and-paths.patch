diff --git a/resource.c b/resource.c
index 0bd6933..0c9f9b8 100644
--- a/resource.c
+++ b/resource.c
@@ -86,6 +86,42 @@ static T_resourceFile IFindOpenResource(T_byte8 *p_filename) ;
 
 static T_void IDiscardEntries(T_resourceEntry *p_entry, T_word16 number) ;
 
+/* GFOS port: a block just read from a resource file, put in the
+ * machine's order by its path (amiga/aa_endian.c). The path is built from
+ * the directories the block is in. */
+static T_void IAAFixLoaded(T_resourceEntry *p_entry)
+{
+#if AA_BIG_ENDIAN
+    T_resourceEntry *chain[8] ;
+    T_resourceEntry *p = p_entry ;
+    char path[160] ;
+    int n = 0, i ;
+
+    while (p != NULL && n < 8)  {
+        T_resourceDirInfo *p_dir = (T_resourceDirInfo *)p->ownerDir ;
+        chain[n++] = p ;
+        if (p_dir == NULL || p_dir->ownerRes == RESOURCE_BAD)
+            break ;
+        p = (T_resourceEntry *)p_dir->ownerRes ;
+    }
+    path[0] = '\0' ;
+    for (i = n - 1; i >= 0; i--)  {
+        char name[15] ;
+        memcpy(name, chain[i]->p_resourceName, 14) ;
+        name[14] = '\0' ;
+        if (strlen(path) + strlen(name) + 2 < sizeof(path))  {
+            if (path[0])
+                strcat(path, "/") ;
+            strcat(path, name) ;
+        }
+    }
+    aa_fix_resource((const char *)G_resourceNames[p_entry->resourceFile],
+                    path, p_entry->p_data, p_entry->size) ;
+#else
+    (void)p_entry ;
+#endif
+}
+
 #ifdef TARGET_UNIX
 typedef struct {
     T_byte8 resID[4]            PACK;
