; $VER: Install-AmuletsArmor 1.05.03a-gfos1 (16.11.2026)
; The Amiga Installer script for Amulets & Armor, an AmiCradle game port.
; Made by amicradle scripts/ports/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the AmuletsArmor drawer where the archive was unpacked.

(set @app-name "Amulets & Armor")
(set #version "1.05.03a-gfos1")
(set #drawer "AmuletsArmor")
(set #program "AmuletsArmor")
(set #space 39063)  ; KB

(onerror
    (message (cat "Amulets & Armor was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-AmuletsArmor again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "Amulets & Armor needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "Amulets & Armor needs a 68040, 68060 or 68080. This Amiga has a " #cpu ".")))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The AmuletsArmor drawer is not beside Install-AmuletsArmor. Unpack the whole archive, then run Install-AmuletsArmor from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The AmuletsArmor drawer has no AmuletsArmor in it. Unpack the whole archive again."))
(if (<> (exists (tackon #from "Libs/acgame.library") (noreq)) 1)
    (abort "The AmuletsArmor drawer has no Libs/acgame.library in it. Unpack the whole archive again."))

(welcome "This installs Amulets & Armor 1.05.03a-gfos1 for AmigaOS 3.2 on a 68040, 68060 or 68080.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the AmuletsArmor drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called AmuletsArmor in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": Amulets & Armor needs 40 MB free.")))

; shared libraries: into LIBS:, where the one there is older or missing
(copylib
    (prompt "Copying acgame.library to LIBS:")
    (help @copylib-help)
    (source (tackon #from "Libs/acgame.library"))
    (dest "LIBS:"))
(complete 40)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "config.ini") (noreq))
    (set #kept (if (= #kept "") "config.ini" (cat #kept "|" "config.ini"))))
(if (exists (tackon #dest "S0000000") (noreq))
    (set #kept (if (= #kept "") "S0000000" (cat #kept "|" "S0000000"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying Amulets & Armor")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating Amulets & Armor. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "AmuletsArmor.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "AmuletsArmor.info")))

(set #later "")
(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. Amulets & Armor would have gone in " #dest "."))
    (message (cat "Amulets & Armor 1.05.03a-gfos1 is installed in " #dest "."
                  "\n\nTo start it, open the AmuletsArmor drawer and double-click the AmuletsArmor icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept "."))
                  (if (= #later "") "" (cat "\n\nStill to add to the drawer: " #later ". Run Install-AmuletsArmor again to fetch or copy it.")))))
(exit (quiet))
